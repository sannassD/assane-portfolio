---
import '../styles/global.css';
import { t, home, links, type Lang } from '../i18n';
import ThemeToggle from '../components/ThemeToggle.astro';
import BackToTop from '../components/BackToTop.astro';

interface Props {
  lang?: Lang;
  title?: string;
  description?: string;
}
const { lang = 'fr' } = Astro.props;
const c = t[lang];
const { title = c.meta.title, description = c.meta.description } = Astro.props;
const other: Lang = lang === 'fr' ? 'en' : 'fr';
const base = home[lang];
const canonical = new URL(Astro.url.pathname, Astro.site);
const isHome = (Object.values(home) as string[]).includes(Astro.url.pathname);
const ogImage = new URL(lang === 'fr' ? '/og-fr.png' : '/og-en.png', Astro.site);
const year = new Date().getFullYear();
const themeLabel = lang === 'fr' ? 'Changer le thème clair / sombre' : 'Toggle light / dark theme';
// À renseigner : code fourni par Google Search Console (vide = rien n'est ajouté).
const googleVerification = '';

const personJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: 'Assane DIA',
  url: 'https://assane.xel-labs.com',
  image: new URL('/images/assane.webp', Astro.site).href,
  alumniOf: { '@type': 'CollegeOrUniversity', name: 'Université Iba Der Thiam de Thiès' },
  knowsLanguage: ['fr', 'en'],
  jobTitle: lang === 'fr' ? 'Développeur full stack, data & IA' : 'Full-stack developer, data & AI',
  worksFor: { '@type': 'Organization', name: 'Xel Labs', url: links.xellabs },
  address: { '@type': 'PostalAddress', addressLocality: 'Thiès', addressCountry: 'SN' },
  sameAs: [links.linkedin, links.github, links.xellabs],
};
---
<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <script is:inline>document.documentElement.classList.add('js');try{var t=localStorage.getItem('theme');if(t)document.documentElement.dataset.theme=t}catch(e){}</script>
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {isHome && <>
      <link rel="alternate" hreflang="fr" href={new URL(home.fr, Astro.site)} />
      <link rel="alternate" hreflang="en" href={new URL(home.en, Astro.site)} />
      <link rel="alternate" hreflang="x-default" href={new URL(home.fr, Astro.site)} />
    </>}
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <meta name="theme-color" content="#10363F" />
    {googleVerification && <meta name="google-site-verification" content={googleVerification} />}
    <meta property="og:type" content="profile" />
    <meta property="og:locale" content={c.meta.locale} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />
    <script defer src="/_vercel/insights/script.js"></script>
    <script type="application/ld+json" set:html={JSON.stringify(personJsonLd)} />
  </head>
  <body class="min-h-screen flex flex-col">
    <a href="#contenu" class="sr-only focus:not-sr-only focus:fixed focus:top-3 focus:left-3 focus:z-50 focus:bg-sun focus:text-ink focus:px-4 focus:py-2 focus:rounded-lg">{c.skip}</a>

    <header class="sticky top-0 z-40 bg-white/95 backdrop-blur border-b border-line">
      <div class="mx-auto max-w-6xl px-4 sm:px-6 h-16 flex items-center justify-between gap-4">
        <a href={base} class="font-display text-lg font-extrabold tracking-tight">Assane DIA<span class="text-sun">.</span></a>
        <nav aria-label={c.navLabel} class="hidden md:flex items-center gap-7">
          {c.nav.map((n) => <a href={`${base}#${n.id}`} data-nav={n.id} class="text-sm font-medium text-muted hover:text-ink transition-colors aria-[current=true]:text-ink aria-[current=true]:underline decoration-sun decoration-2 underline-offset-8">{n.label}</a>)}
          <a href={home[other]} hreflang={other} lang={other} aria-label={c.switchLabel} class="text-sm font-bold uppercase border border-line rounded-full h-9 px-3 inline-flex items-center hover:border-ink">{other}</a>
          <ThemeToggle label={themeLabel} class="border-line hover:border-ink" />
          <a href={`${base}#contact`} class="inline-flex items-center h-10 px-5 rounded-full bg-ink text-white text-sm font-semibold hover:bg-ink-deep transition-colors">{c.cta}</a>
        </nav>
        <div class="md:hidden flex items-center gap-2">
        <ThemeToggle label={themeLabel} class="border-line" />
        <details class="group relative">
          <summary class="list-none cursor-pointer inline-flex items-center justify-center w-11 h-11 rounded-lg hover:bg-mist" aria-label={c.menu}>
            <svg class="group-open:hidden" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><path d="M4 7h16M4 12h16M4 17h16" /></svg>
            <svg class="hidden group-open:block" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><path d="M6 6l12 12M18 6L6 18" /></svg>
          </summary>
          <nav aria-label={c.navLabel} class="absolute right-0 top-14 w-64 rounded-2xl bg-white border border-line p-3 shadow-2xl flex flex-col">
            {c.nav.map((n) => <a href={`${base}#${n.id}`} class="px-4 py-3 rounded-lg hover:bg-mist">{n.label}</a>)}
            <a href={home[other]} hreflang={other} lang={other} class="px-4 py-3 rounded-lg hover:bg-mist">{c.switchLabel}</a>
            <a href={`${base}#contact`} class="mt-2 px-4 py-3 rounded-lg bg-ink text-white font-semibold text-center">{c.cta}</a>
          </nav>
        </details>
        </div>
      </div>
    </header>

    <main id="contenu" class="flex-1"><slot /></main>
    <BackToTop label={lang === 'fr' ? 'Revenir en haut' : 'Back to top'} />

    <footer class="bg-ink-deep text-muted-dark">
      <div class="mx-auto max-w-6xl px-4 sm:px-6 py-12 grid gap-8 md:grid-cols-[1.5fr_1fr_1fr]">
        <div class="flex flex-col gap-2">
          <p class="font-display text-xl font-extrabold text-white">Assane DIA<span class="text-sun">.</span></p>
          <p class="text-sm">{c.hero.kicker}</p>
          <p class="text-sm">{c.hero.location}</p>
        </div>
        <nav aria-label={c.navLabel} class="flex flex-col gap-2 text-sm">
          {c.nav.map((n) => <a href={`${base}#${n.id}`} class="hover:text-white">{n.label}</a>)}
        </nav>
        <div class="flex flex-col gap-2 text-sm">
          <a href={`mailto:${links.email}`} class="hover:text-white">{links.email}</a>
          <a href={links.linkedin} target="_blank" rel="noopener" class="hover:text-white">LinkedIn</a>
          <a href={links.github} target="_blank" rel="noopener" class="hover:text-white">GitHub</a>
          <a href={links.xellabs} class="hover:text-white">xel-labs.com</a>
        </div>
      </div>
      <div class="border-t border-white/10">
        <div class="mx-auto max-w-6xl px-4 sm:px-6 py-5 text-xs flex flex-wrap justify-between gap-2">
          <span>© {year} Assane DIA. {c.footer.rights}</span>
<a href={lang === 'fr' ? '/mentions-legales' : '/en/legal-notice'} class="hover:text-white underline underline-offset-4">{c.legal}</a>
        </div>
      </div>
    </footer>

    <script>
      document.querySelectorAll('header details a').forEach((a) => {
        a.addEventListener('click', () => a.closest('details')?.removeAttribute('open'));
      });
      const items = document.querySelectorAll('.reveal');
      if ('IntersectionObserver' in window) {
        const io = new IntersectionObserver((entries) => {
          entries.forEach((e) => {
            if (e.isIntersecting) {
              e.target.classList.add('is-visible');
              io.unobserve(e.target);
            }
          });
        }, { rootMargin: '0px 0px -8% 0px' });
        items.forEach((el) => io.observe(el));
      } else {
        items.forEach((el) => el.classList.add('is-visible'));
      }

      // Surligne dans le menu la section affichée
      const navLinks = document.querySelectorAll<HTMLElement>('[data-nav]');
      if ('IntersectionObserver' in window && navLinks.length) {
        const spy = new IntersectionObserver((entries) => {
          entries.forEach((e) => {
            if (!e.isIntersecting) return;
            navLinks.forEach((a) => a.setAttribute('aria-current', String(a.dataset.nav === e.target.id)));
          });
        }, { rootMargin: '-45% 0px -50% 0px' });
        navLinks.forEach((a) => { const s = document.getElementById(a.dataset.nav!); if (s) spy.observe(s); });
      }
    </script>
  </body>
</html>
