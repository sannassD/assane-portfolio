---
/**
 * Logo officiel d'une plateforme ou d'une technologie, via Simple Icons (licence CC0).
 * color="brand" : couleur officielle ; color="current" : couleur du texte parent.
 * LinkedIn n'est plus dans Simple Icons : son logo officiel est fourni ici.
 */
import * as icons from 'simple-icons';

interface Props {
  name: string | null;
  size?: number;
  color?: 'brand' | 'current';
  class?: string;
}
const { name, size = 20, color = 'current', class: className = '' } = Astro.props;
const extra = {
  siLinkedin: { title: 'LinkedIn', hex: '0A66C2', path: 'M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433a2.062 2.062 0 1 1 0-4.125 2.062 2.062 0 0 1 0 4.125zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z' },
};
const all = { ...icons, ...extra } as Record<string, { path: string; hex: string; title: string } | undefined>;
const icon = name ? all[name] : undefined;
const fill = icon && color === 'brand' ? `#${icon.hex}` : 'currentColor';
// Couleur de marque trop sombre pour le mode sombre (luminance faible)
const hex = icon?.hex ?? 'ffffff';
const dark = color === 'brand' && (0.299 * parseInt(hex.slice(0, 2), 16) + 0.587 * parseInt(hex.slice(2, 4), 16) + 0.114 * parseInt(hex.slice(4, 6), 16)) < 60;
---
{icon ? (
  <svg width={size} height={size} viewBox="0 0 24 24" class={className} aria-hidden="true" fill={fill} data-brand-dark={dark ? '' : undefined}>
    <path d={icon.path} />
  </svg>
) : (
  <svg width={size} height={size} viewBox="0 0 24 24" class={className} aria-hidden="true" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
    <rect x="3" y="7" width="18" height="13" rx="2" />
    <path d="M8 7V5a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2 M3 13h18" />
  </svg>
)}
