---
// Bouton « Revenir en haut », visible après un peu de défilement.
interface Props {
  label: string;
  class?: string;
}
const { label, class: className = 'bottom-5 right-5' } = Astro.props;
---
<a href="#" data-back-to-top aria-label={label} title={label}
  class:list={['fixed z-30 inline-flex w-12 h-12 items-center justify-center rounded-full bg-[#10363F] text-white shadow-lg shadow-black/25 border border-white/15 opacity-0 translate-y-3 pointer-events-none transition duration-300 hover:bg-[#F2B33D] hover:text-[#10363F]', className]}>
  <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 19V5M5 12l7-7 7 7" /></svg>
</a>

<script>
  const btn = document.querySelector<HTMLElement>('[data-back-to-top]');
  if (btn) {
    const toggle = () => {
      const show = window.scrollY > 700;
      btn.classList.toggle('opacity-0', !show);
      btn.classList.toggle('translate-y-3', !show);
      btn.classList.toggle('pointer-events-none', !show);
    };
    window.addEventListener('scroll', toggle, { passive: true });
    toggle();
    btn.addEventListener('click', (e) => {
      e.preventDefault();
      window.scrollTo({ top: 0, behavior: 'smooth' });
    });
  }
</script>
